---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import profileImage from "../../assets/profil.jpeg";
import { profile } from "../../data/profile";

const facts = [
  { label: "Lokasi", value: profile.location },
  { label: "Sekolah", value: profile.school },
  { label: "Sedang dipelajari", value: profile.currentFocus },
];
---

<section id="home" aria-labelledby="hero-heading" class="pb-20 pt-14 sm:pb-28 sm:pt-24 lg:pt-32">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="reveal text-sm text-muted" style="--reveal-delay: 0ms">
          Portfolio · {profile.role}
        </p>
        <h1
          id="hero-heading"
          class="reveal mt-5 break-words text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl lg:text-7xl"
          style="--reveal-delay: 90ms"
        >
          {profile.name}
        </h1>
        <p
          class="reveal mt-6 font-serif text-2xl italic text-sage-dark sm:text-3xl"
          style="--reveal-delay: 170ms"
        >
          {profile.tagline}
        </p>
        <p
          class="reveal mt-6 max-w-xl text-base text-muted sm:text-lg"
          style="--reveal-delay: 240ms"
        >
          {profile.intro}
        </p>
        <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay: 310ms">
          <Button href="#projects">Lihat Proyek</Button>
          <Button href="#contact" variant="secondary">Hubungi Saya</Button>
        </div>
      </div>

      <div
        class="reveal reveal--portrait group relative mx-auto w-full max-w-[22rem] lg:col-span-5 lg:ml-auto lg:max-w-[26rem]"
        style="--reveal-delay: 180ms"
      >
        <div aria-hidden="true" class="absolute -bottom-3 -right-3 -z-10 h-full w-full border border-sage/40">
        </div>
        <div class="aspect-[4/5] overflow-hidden border border-line bg-sage-pale">
          <Image
            src={profileImage}
            alt={`Foto profil ${profile.name}`}
            loading="eager"
            class="h-full w-full object-cover object-[center_56%] transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </div>
      </div>
    </div>

    <dl class="reveal mt-14 grid gap-x-8 sm:grid-cols-3">
      {facts.map((fact) => (
        <div class="border-t border-line py-4">
          <dt class="text-sm text-muted">{fact.label}</dt>
          <dd class="mt-1 font-medium">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
