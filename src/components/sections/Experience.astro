---
import Container from "../layout/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { experiences } from "../../data/experiences";
---

<section id="experience" aria-labelledby="experience-heading" class="py-20 sm:py-28">
  <Container>
    <div class="reveal">
      <SectionHeading id="experience-heading" eyebrow="Pengalaman" title="Pendidikan & pengalaman" />
    </div>

    <ol class="reveal mt-12">
      {experiences.map((item) => (
        <li class="grid gap-2 border-t border-line py-7 md:grid-cols-12 md:gap-8">
          <p class="text-sm text-muted md:col-span-3 md:pt-1">{item.period}</p>
          <div class="md:col-span-9">
            <h3 class="text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-1 text-sage-dark">{item.organization}</p>
            <p class="mt-3 max-w-xl text-muted">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>
