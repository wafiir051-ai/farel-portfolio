---
import Container from "../layout/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { skills } from "../../data/skills";
import type { SkillStatus } from "../../types/portfolio";

const statusLabel: Record<SkillStatus, string> = {
  learning: "Sedang dipelajari",
  familiar: "Familiar",
  used: "Dipakai di proyek",
  experienced: "Berpengalaman",
  mastered: "Dikuasai",
};
---

<section id="skills" aria-labelledby="skills-heading" class="py-20 sm:py-28">
  <Container>
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-4">
        <SectionHeading
          id="skills-heading"
          eyebrow="Kemampuan"
          title="Teknologi yang saya gunakan dan pelajari."
        />
        <p class="mt-4 max-w-sm text-muted">
          Beberapa teknologi sudah saya kuasai, sementara Flutter masih saya pelajari.
        </p>
      </div>
      <div class="reveal lg:col-span-7 lg:col-start-6">
        {skills.map((group) => (
          <div class="grid gap-3 border-t border-line py-6 sm:grid-cols-12">
            <h3 class="font-medium sm:col-span-4">{group.category}</h3>
            <ul class="sm:col-span-8">
              {group.items.map((skill) => (
                <li class="flex items-baseline justify-between gap-4">
                  <span>{skill.name}</span>
                  <span class="text-sm text-muted">{statusLabel[skill.status]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
