---
import Container from "./Container.astro";
import { profile } from "../../data/profile";

const links = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];

const linkClass =
  "relative py-2 text-sm text-muted transition-colors duration-200 hover:text-foreground after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-sage-dark after:transition-transform after:duration-200 hover:after:scale-x-100 motion-reduce:after:transition-none";
---

<header class="sticky top-0 z-40 border-b border-line bg-background">
  <Container>
    <nav aria-label="Navigasi utama" class="flex h-16 items-center justify-between gap-4">
      <a href="#home" class="truncate font-medium tracking-tight">{profile.name}</a>

      <ul class="hidden items-center gap-8 md:flex">
        {links.map((link) => (
          <li><a href={link.href} class={linkClass}>{link.label}</a></li>
        ))}
        {profile.cvUrl && (
          <li>
            <a
              href={profile.cvUrl}
              class="inline-flex min-h-10 items-center rounded-md bg-sage-dark px-4 text-sm font-medium text-white transition-colors duration-200 hover:bg-foreground"
            >
              CV
            </a>
          </li>
        )}
      </ul>

      <button
        id="nav-toggle"
        type="button"
        class="-mr-2 inline-flex size-11 items-center justify-center md:hidden"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Buka menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </nav>
  </Container>

  <div id="nav-menu" class="hidden border-t border-line md:hidden">
    <Container>
      <ul class="py-2">
        {links.map((link) => (
          <li class="border-b border-line last:border-b-0">
            <a href={link.href} class="flex min-h-12 items-center text-base">{link.label}</a>
          </li>
        ))}
        {profile.cvUrl && (
          <li class="py-3">
            <a
              href={profile.cvUrl}
              class="inline-flex min-h-11 items-center rounded-md bg-sage-dark px-5 text-sm font-medium text-white"
            >
              Unduh CV
            </a>
          </li>
        )}
      </ul>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
      menu.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
