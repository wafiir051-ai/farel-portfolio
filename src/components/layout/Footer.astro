---
import Container from "./Container.astro";
import { profile } from "../../data/profile";
import { socialLinks } from "../../data/social-links";

const year = new Date().getFullYear();
const links = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<footer class="border-t border-line py-10">
  <Container class="flex flex-col gap-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {profile.name}</p>
    <nav aria-label="Navigasi footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map((link) => (
          <li><a href={link.href} class="inline-block py-1 hover:text-foreground">{link.label}</a></li>
        ))}
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} class="inline-block py-1 hover:text-foreground" target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</footer>
