---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<div>
  {eyebrow && <p class="mb-3 text-sm text-muted">{eyebrow}</p>}
  <h2 id={id} class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
    {title}
  </h2>
</div>
