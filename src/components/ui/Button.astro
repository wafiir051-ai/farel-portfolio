---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  external?: boolean;
}

const { href, variant = "primary", external = false } = Astro.props;

const base =
  "inline-flex min-h-11 items-center justify-center rounded-md px-5 text-sm font-medium transition-colors duration-200";
const variants = {
  primary: "bg-sage-dark text-white hover:bg-foreground",
  secondary:
    "border border-foreground/25 text-foreground hover:border-sage-dark hover:text-sage-dark",
};
---

<a
  href={href}
  class:list={[base, variants[variant]]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
</a>
